# ===== SG Academia · servidor de medios propio (VPS) =====
# Dominios (creá los registros A apuntando a la IP del VPS ANTES de instalar; Caddy emite TLS solo)
MEET_DOMAIN=meet.sg-academia.com
LIVE_DOMAIN=live.sg-academia.com
LETSENCRYPT_EMAIL=admin@sg-bolivia.com
PUBLIC_IP=

# URL de la app en Railway (para callbacks de auth y eventos)
LMS_URL=https://academia-app-production-039a.up.railway.app
# Secreto compartido con la app (misma variable LIVE_SECRET en Railway)
LIVE_SECRET=cambiame-32-chars-aleatorios

# Jitsi propio con JWT (mismos valores en Railway: JITSI_DOMAIN, JITSI_APP_ID, JITSI_APP_SECRET)
JITSI_APP_ID=sgacademia
JITSI_APP_SECRET=cambiame-otro-secreto-largo

# Secretos internos de Jitsi (cualquier string aleatorio, generados por install.sh)
JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=
JIGASI_XMPP_PASSWORD=
JIBRI_RECORDER_PASSWORD=
JIBRI_XMPP_PASSWORD=

# Grabaciones: se guardan en ./recordings y se sirven en https://LIVE_DOMAIN/rec/...
# (opcional) subir además a Bunny Stream:
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
